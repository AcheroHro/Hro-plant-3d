{
  "id": "/",
  "name": "Achero Plant 3D",
  "short_name": "Plant 3D",
  "description": "Corrección de cañerías en campo con ida y vuelta por PCF a AutoCAD Plant 3D: spools, isométricos y registro de cambios sin conexión.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#12161f",
  "theme_color": "#12161f",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "files",
          "accept": [".pcf", ".json", "text/plain", "application/json", "application/octet-stream"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".pcf"],
        "application/json": [".achero"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
